{
  // Use R from your conda env 'r_env' so Quarto and the VS Code R extension run the correct R.
  "r.rterm.linux": "~/miniforge3/envs/r_env/bin/R",

  // Also point the R extension's R path to the same binary (used by some features/debugger).
  "r.rpath.linux": "~/miniforge3/envs/r_env/bin/R",

  // Start integrated terminals as a login shell so conda initialization runs (enables `conda activate r_env`).
  "terminal.integrated.shellArgs.linux": ["-l"],

  // Ensure the Bash profile uses login args; helpful for conda-managed environments.
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "args": ["-l"]
    }
  },

  // Make Bash the default terminal profile in VS Code on Linux.
  "terminal.integrated.defaultProfile.linux": "bash"
}
