# What belongs in no repository here, public or private.
#
# The root .gitignore answers a different question -- what may be published --
# and it hides the handouts, data and course folders the private repositories
# exist to keep. So `private-git NAME save` bypasses it entirely and consults
# this file instead: everything in the folder is staged except what is listed
# below, all of which a command rebuilds from source that IS tracked.
#
# Adding a pattern here loses files from the private side. Only add one when a
# documented command regenerates what it matches.

# Environments and dependency trees -- pyproject.toml + uv.lock, environment.yml
.venv/
venv/
node_modules/

# Bytecode and tool caches
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Build trees -- cmake, javac
build/
target/
bin/
*.class

# Render caches and output that `quarto render` rewrites
.quarto/
_freeze/
_site/

# LaTeX intermediates; the compiled PDF is the deliverable and stays
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# R session state, not work
.Rhistory
.RData
.Rproj.user/

# Credentials never reach a remote, private or not
.env
.env.*

# Interrupted downloads; only a new download repairs one
*.crdownload

# OS litter
.DS_Store
Thumbs.db
