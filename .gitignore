# What belongs in no repository, private or public: what a documented command
# rebuilds, what a session leaves behind, and secrets. What the public copy
# withholds is a different question, answered by .publishignore.

# Environments and dependency trees; pyproject.toml, uv.lock and environment.yml rebuild them
.venv/
venv/
node_modules/

# Bytecode and tool caches
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Build trees and objects: cmake, make, javac
build/
build-tests/
target/
bin/
bin_backup*/
*.class
*.o
Master/M1/S7/AlgorithmicProblemSolving/APP1-maze/implementation/maze
Master/M1/S7/AlgorithmicProblemSolving/APP1-maze/implementation/tests
!Master/M1/S7/AlgorithmicProblemSolving/APP1-maze/implementation/tests/
Master/M1/S7/AlgorithmicProblemSolving/APP1-maze/implementation/benchmark
# The mazes the APP1 program draws; running it draws them again
Master/M1/S7/AlgorithmicProblemSolving/**/*.svg

# Render caches and output that `quarto render` rewrites
.quarto/
_freeze/
_site/
*_files/
# except the figures the rendered reports embed, which GitHub Pages serves
!**/rapport/**/*_files/

# LaTeX intermediates; the compiled PDF is the deliverable and stays
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# R session state, not work
.Rhistory
.RData
.Rproj.user/

# Figures and downloads the practicals produce when run
Master/M1/**/patterns_demo.png
Master/M1/S7/Programming/Python/TP1-environments/WeatherMapApp/france_map.png

# Credentials never reach a remote, private or not: a pushed secret cannot be
# unpushed. API keys are read from the environment.
.env
.env.*
!.env.example

# Interrupted downloads, VM images, OS litter
*.crdownload
*.qcow2
.DS_Store
Thumbs.db
