# Language statistics
#
# GitHub's language bar counts bytes on disk, which badly misrepresents this
# repo: 104 MB of Quarto output (99% of all HTML here) drowns out the code,
# while the .qmd sources that produced it are not counted at all.
#
# The HTML is kept because GitHub Pages serves this repo from main at root and
# the course READMEs link to it directly -- it is published, not stale build
# output. So it is reclassified rather than deleted.

# Quarto renders with embed-resources, inlining bootstrap, webfonts and every
# figure as base64 -- which is how a 500-line .qmd becomes a 5 MB .html.
Bachelor/L3/S5/ComplementMath1/html/**       linguist-generated=true
Bachelor/L3/S5/MathStat2/TPs/html/**         linguist-generated=true
Bachelor/L3/S6/MathStat3/html/**             linguist-generated=true
Bachelor/L3/S6/ComplementMath2/TP/html/**    linguist-generated=true

# Published Quarto sites and generated javadoc.
**/rapport/**                                linguist-generated=true
Bachelor/Java/**/docs/api/**                 linguist-generated=true

# Bootstrap, tippy, popper, anchor and axe, vendored by Quarto.
**/*_files/libs/**                           linguist-vendored=true

# The real work. 39 .qmd/.Rmd files hold 13,623 lines and 707 R chunks, none of
# which linguist counts by default -- Quarto and R Markdown are classified as
# prose, so they are excluded from the language bar unless made detectable.
*.qmd                    linguist-language=R linguist-detectable=true
*.Rmd                    linguist-language=R linguist-detectable=true

# The published site's own pages. They document the work rather than being more
# of it, and the markup is already on show as the site itself, so it does not
# need a slice of the language bar. Listed one by one on purpose: a glob on
# index.html would also swallow WebDev/TP3 and TP5, which ARE coursework.
# site/style.css and site/*.js stay counted; those are hand-written and are work.
/index.html                                      linguist-documentation=true
/404.html                                        linguist-documentation=true
Bachelor/index.html                              linguist-documentation=true
Bachelor/Java/index.html                         linguist-documentation=true
Bachelor/Java/OOP/index.html                     linguist-documentation=true
Bachelor/Java/BattleshipAI/index.html            linguist-documentation=true
Bachelor/SecondSemestreLanguage/index.html       linguist-documentation=true
Bachelor/SecondSemestreLanguage/*/index.html     linguist-documentation=true
Bachelor/SecondSemestreLanguage/Prolog/StrategyTournament/index.html linguist-documentation=true
Bachelor/L3/S5/*/index.html                      linguist-documentation=true
Bachelor/L3/S6/*/index.html                      linguist-documentation=true
Master/index.html                                linguist-documentation=true
