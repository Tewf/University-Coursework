{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "BUILD_TESTS": "ON" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug, tests on",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "displayName": "Debug with AddressSanitizer and UBSan",
      "cacheVariables": { "ENABLE_SANITIZERS": "ON" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release, tests on",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "python",
      "inherits": "release",
      "displayName": "Release, plus the pybind11 modules",
      "cacheVariables": { "BUILD_PYTHON_LIB": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "debug" },
    { "name": "asan",    "configurePreset": "asan" },
    { "name": "release", "configurePreset": "release" },
    { "name": "python",  "configurePreset": "python" }
  ],
  "testPresets": [
    { "name": "debug",   "configurePreset": "debug",   "output": { "outputOnFailure": true } },
    { "name": "asan",    "configurePreset": "asan",    "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
